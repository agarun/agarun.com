    "next-seo": "^6.6.0",
    "prism-theme-vars": "^0.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^6.1.0",
    "rehype-external-links": "^1.0.0",
